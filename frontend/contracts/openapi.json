{
  "openapi": "3.1.0",
  "info": {
    "title": "Órbita API",
    "version": "0.2",
    "description": "Shared frontend/backend contract. Simulation and read-only; the user's drafts stay in the browser. Records follow the main app's schema 2."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Technical state of the process",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "contractVersion"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "type": "string"
                    },
                    "contractVersion": {
                      "const": "0.2"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/astronauts": {
      "get": {
        "operationId": "listAstronauts",
        "responses": {
          "200": {
            "description": "Synthetic data; medical validation pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AstronautsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/astronauts/{astronautId}/measurements": {
      "get": {
        "operationId": "getMeasurements",
        "parameters": [
          {
            "name": "astronautId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic data; medical validation pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown astronaut",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/astronauts/{astronautId}/mission": {
      "get": {
        "operationId": "getMission",
        "parameters": [
          {
            "name": "astronautId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic data; medical validation pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown astronaut",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AstronautsResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "callsign": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "mission": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "callsign",
                "role",
                "mission"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "type": "string",
                "const": "0.2"
              },
              "dataKind": {
                "type": "string",
                "const": "synthetic"
              },
              "clinicalValidation": {
                "type": "string",
                "const": "pending"
              }
            },
            "required": [
              "contractVersion",
              "dataKind",
              "clinicalValidation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "MeasurementsResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "type": "number",
                  "const": 2
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "measurement",
                    "action",
                    "environment",
                    "exam"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "recorded",
                    "confirmed_none",
                    "not_recorded"
                  ]
                },
                "variable": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit_status": {
                  "type": "string",
                  "enum": [
                    "known",
                    "unknown"
                  ]
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "time": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_time": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "raw": {
                      "type": "string",
                      "minLength": 1
                    },
                    "precision": {
                      "type": "string",
                      "enum": [
                        "date",
                        "minute",
                        "second"
                      ]
                    },
                    "timezone": {
                      "type": "null"
                    },
                    "calendar": {
                      "type": "string",
                      "enum": [
                        "original",
                        "shifted",
                        "unknown"
                      ]
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "value",
                    "raw",
                    "precision",
                    "timezone",
                    "calendar",
                    "scope"
                  ],
                  "additionalProperties": false
                },
                "interval": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "to": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "synthetic",
                    "ground_analog",
                    "terrestrial",
                    "flight",
                    "cell_culture"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "mission_phase": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "place": {
                  "type": "string",
                  "minLength": 1
                },
                "sensor": {
                  "type": "string",
                  "minLength": 1
                },
                "corrects": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "schema_version",
                "type",
                "state",
                "variable",
                "method",
                "time",
                "origin",
                "source",
                "mission_phase",
                "subject"
              ],
              "additionalProperties": false
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "label",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "type": "string",
                "const": "0.2"
              },
              "dataKind": {
                "type": "string",
                "const": "synthetic"
              },
              "clinicalValidation": {
                "type": "string",
                "const": "pending"
              }
            },
            "required": [
              "contractVersion",
              "dataKind",
              "clinicalValidation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "metrics",
          "meta"
        ],
        "additionalProperties": false
      },
      "MissionResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema_version": {
                      "type": "number",
                      "const": 2
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "observation",
                        "measurement",
                        "action",
                        "environment",
                        "exam"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "recorded",
                        "confirmed_none",
                        "not_recorded"
                      ]
                    },
                    "variable": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "unit_status": {
                      "type": "string",
                      "enum": [
                        "known",
                        "unknown"
                      ]
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "time": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source_time": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "raw": {
                          "type": "string",
                          "minLength": 1
                        },
                        "precision": {
                          "type": "string",
                          "enum": [
                            "date",
                            "minute",
                            "second"
                          ]
                        },
                        "timezone": {
                          "type": "null"
                        },
                        "calendar": {
                          "type": "string",
                          "enum": [
                            "original",
                            "shifted",
                            "unknown"
                          ]
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "value",
                        "raw",
                        "precision",
                        "timezone",
                        "calendar",
                        "scope"
                      ],
                      "additionalProperties": false
                    },
                    "interval": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        },
                        "to": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "synthetic",
                        "ground_analog",
                        "terrestrial",
                        "flight",
                        "cell_culture"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mission_phase": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "place": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sensor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "corrects": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "schema_version",
                    "type",
                    "state",
                    "variable",
                    "method",
                    "time",
                    "origin",
                    "source",
                    "mission_phase",
                    "subject"
                  ],
                  "additionalProperties": false
                }
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema_version": {
                      "type": "number",
                      "const": 2
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "day": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assigned_by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "completion": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "done",
                        "not_done"
                      ]
                    },
                    "result_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "procedure_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "execution_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "not_done_note": {
                      "type": "object",
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "scheduled_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "planned_minutes": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "schema_version",
                    "subject",
                    "day",
                    "description",
                    "assigned_by",
                    "completion",
                    "result_ids"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "records",
              "tasks"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "properties": {
              "contractVersion": {
                "type": "string",
                "const": "0.2"
              },
              "dataKind": {
                "type": "string",
                "const": "synthetic"
              },
              "clinicalValidation": {
                "type": "string",
                "const": "pending"
              }
            },
            "required": [
              "contractVersion",
              "dataKind",
              "clinicalValidation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
