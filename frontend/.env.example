# Por defecto no se necesita backend ni archivo .env.local.
HEALTH_DATA_SOURCE=mock

# Configurar el destino permite alternar con el botón superior o ?source=api.
# HEALTH_DATA_SOURCE solo define el modo inicial cuando no hay parámetro source.
# El backend 0.1 también entrega datos sintéticos; no habilita datos reales.
# Para consumir el backend independiente (backend/, puerto 4000):
# HEALTH_API_BASE_URL=http://127.0.0.1:4000/api/v1
