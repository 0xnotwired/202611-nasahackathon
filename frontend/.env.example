# By default neither a backend nor a .env.local file is needed.
HEALTH_DATA_SOURCE=mock

# Setting the target allows switching with the top button or ?source=api.
# HEALTH_DATA_SOURCE only sets the initial mode when there is no source parameter.
# The 0.2 backend also serves synthetic data; it does not enable real data.
# To use the independent backend (backend/, port 4000):
# HEALTH_API_BASE_URL=http://127.0.0.1:4000/api/v1
